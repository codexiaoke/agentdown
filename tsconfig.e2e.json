{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client",
      "@playwright/test"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts",
    "e2e/**/*.vue"
  ]
}

{
  "name": "agentdown",
  "version": "0.1.0-rc.1",
  "description": "Reactive agent-native markdown UI runtime for Vue, powered by markdown-it and @chenglou/pretext.",
  "type": "module",
  "license": "MIT",
  "author": "xiaoke",
  "homepage": "https://codexiaoke.github.io/agentdown/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codexiaoke/agentdown.git"
  },
  "bugs": {
    "url": "https://github.com/codexiaoke/agentdown/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "vite",
    "agent",
    "generative-ui",
    "markdown",
    "pretext",
    "runtime",
    "npm"
  ],
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ag-ui": {
      "types": "./dist/entries/ag-ui.d.ts",
      "import": "./dist/ag-ui.js",
      "require": "./dist/ag-ui.cjs"
    },
    "./a2ui": {
      "types": "./dist/entries/a2ui.d.ts",
      "import": "./dist/a2ui.js",
      "require": "./dist/a2ui.cjs"
    },
    "./ag-ui-a2ui": {
      "types": "./dist/entries/ag-ui-a2ui.d.ts",
      "import": "./dist/ag-ui-a2ui.js",
      "require": "./dist/ag-ui-a2ui.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:types",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.types.json",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "backend:dev": "uv run --project backend uvicorn app.main:app --app-dir backend --reload --port 8000",
    "backend:check": "uv run --project backend python -m compileall backend/app",
    "backend:test": "cd backend && uv run python -m unittest discover -s tests -v",
    "backend:smoke:langchain": "uv run --project backend python backend/scripts/smoke_langchain.py",
    "backend:smoke:crewai": "uv run --project backend python backend/scripts/smoke_crewai.py",
    "benchmark:streaming-markdown": "node scripts/benchmark-streaming-markdown.mjs",
    "audit:production": "npm audit --omit=dev",
    "pack:check": "npm pack --dry-run",
    "release:check": "npm test && npm run typecheck && npm run test:e2e && npm run docs:build && npm run test:package-consumer && npm run audit:production && npm run pack:check",
    "release:verify": "node scripts/verify-release.mjs",
    "test:package-consumer": "npm run build && node scripts/test-package-consumer.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --project=chrome",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.e2e.json",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@a2ui/web_core": "^0.10.6",
    "@ag-ui/core": "^0.0.57",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@a2ui/web_core": {
      "optional": true
    },
    "@ag-ui/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.2",
    "katex": "^0.16.44",
    "markdown-it": "^14.3.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-math": "^5.2.1",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@a2ui/web_core": "^0.10.6",
    "@ag-ui/core": "^0.0.57",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^4.0.0",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.2",
    "vue": "^3.5.31",
    "vue-tsc": "^3.2.6"
  }
}
